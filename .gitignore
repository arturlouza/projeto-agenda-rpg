# Ambiente virtual: pode ser recriado com o requirements.txt
.venv/

# Arquivos que o Python gera sozinho
__pycache__/
*.pyc

# Cache do pytest
.pytest_cache/

# Banco SQLite local: dados de desenvolvimento, não código
*.db

# Segredos, como senhas: nunca devem ser publicados
.env
.env.*
# Exceção: um modelo só com os nomes das variáveis, sem valores, pode ser publicado
!.env.example

# Configurações pessoais do Claude Code nesta máquina: não valem para o projeto
.claude/settings.local.json

# Miniaturas de imagens que o Windows cria sozinho dentro das pastas
Thumbs.db

# Preferências de exibição de pasta que o Windows cria sozinho
desktop.ini
